---
// src/components/ZohoLeadForm.astro
---

<form
  id="consultation-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-4 max-w-lg mx-auto bg-slate-900/60 p-8 rounded-2xl border border-slate-800"
>
  <!-- Replace with your Web3Forms access key -->
  <input type="hidden" name="access_key" value="a0ac6645-0ce0-430f-af66-f4cf82e0c022" />

  <!-- Form control options -->
  <input type="hidden" name="from_name" value="Automentra Leads" />
  <input type="hidden" id="email-subject" name="subject" value="New Enquiry from Website Lead" />
  <input type="hidden" name="redirect" value="https://automentra.netlify.app/?submitted=true" />
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="first_name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
        First Name *
      </label>
      <input
        type="text"
        id="first_name"
        name="First Name"
        required
        placeholder="Jane"
        class="w-full px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 text-sm"
      />
    </div>

    <div>
      <label for="last_name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
        Last Name *
      </label>
      <input
        type="text"
        id="last_name"
        name="Last Name"
        required
        placeholder="Doe"
        class="w-full px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 text-sm"
      />
    </div>
  </div>

  <div>
    <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
      Work Email *
    </label>
    <input
      type="email"
      id="email"
      name="Email"
      required
      placeholder="jane@company.com"
      class="w-full px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 text-sm"
    />
  </div>

  <div>
    <label for="company" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
      Company Name *
    </label>
    <input
      type="text"
      id="company"
      name="Company"
      required
      placeholder="Acme Enterprises"
      class="w-full px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 text-sm"
    />
  </div>

  <div>
    <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
      Project Details / Requirements
    </label>
    <textarea
      id="message"
      name="Project Details"
      rows="4"
      placeholder="Tell us about your IFS Cloud BPA or automation project..."
      class="w-full px-4 py-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 text-sm"
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full py-3 px-6 rounded-lg bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold hover:opacity-95 transition-opacity text-sm shadow-lg shadow-purple-900/30"
  >
    Request BPA Architecture Consultation
  </button>
</form>

<script>
  const form = document.getElementById('consultation-form') as HTMLFormElement;
  const firstNameInput = document.getElementById('first_name') as HTMLInputElement;
  const lastNameInput = document.getElementById('last_name') as HTMLInputElement;
  const subjectInput = document.getElementById('email-subject') as HTMLInputElement;

  if (form && firstNameInput && lastNameInput && subjectInput) {
    form.addEventListener('submit', () => {
      const first = firstNameInput.value.trim();
      const last = lastNameInput.value.trim();
      subjectInput.value = `New Enquiry from ${first} ${last}`.trim();
    });
  }
</script>