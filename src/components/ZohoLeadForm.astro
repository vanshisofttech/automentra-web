---
---
<form 
  action="https://crm.zoho.com/crm/WebToLeadForm" 
  name="AutomentraLeadForm" 
  method="POST" 
  accept-charset="UTF-8"
  class="space-y-4"
>
  <input type="hidden" name="xnQsjsdp" value="YOUR_XNQSJSDP_TOKEN" />
  <input type="hidden" name="xmIwtLDp" value="YOUR_XMIWTLDP_TOKEN" />
  <input type="hidden" name="actionType" value="TGVhZHM=" />
  <input type="hidden" name="returnURL" value="https://www.automenta.com/thank-you" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">First Name *</label>
      <input type="text" name="First Name" required placeholder="John" class="w-full px-4 py-2.5 rounded-lg bg-brand-dark border border-brand-border text-white focus:outline-none focus:border-brand-purple" />
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Last Name *</label>
      <input type="text" name="Last Name" required placeholder="Doe" class="w-full px-4 py-2.5 rounded-lg bg-brand-dark border border-brand-border text-white focus:outline-none focus:border-brand-purple" />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Work Email *</label>
      <input type="email" name="Email" required placeholder="johndoe@enterprise.com" class="w-full px-4 py-2.5 rounded-lg bg-brand-dark border border-brand-border text-white focus:outline-none focus:border-brand-purple" />
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Company / Organization *</label>
      <input type="text" name="Company" required placeholder="Acme Global Inc." class="w-full px-4 py-2.5 rounded-lg bg-brand-dark border border-brand-border text-white focus:outline-none focus:border-brand-purple" />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Current IFS Platform</label>
      <select name="IFS_Version" class="w-full px-4 py-2.5 rounded-lg bg-brand-dark border border-brand-border text-slate-200 focus:outline-none focus:border-brand-purple">
        <option value="IFS Apps 9/10">IFS Applications 9 / 10</option>
        <option value="IFS Cloud 21R1-22R2">IFS Cloud 21R1 – 22R2</option>
        <option value="IFS Cloud 23R1+">IFS Cloud 23R1+</option>
        <option value="Evaluation / Migration Stage">Planning Upgrade to IFS Cloud</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Primary Objective</label>
      <select name="Service_Interest" class="w-full px-4 py-2.5 rounded-lg bg-brand-dark border border-brand-border text-slate-200 focus:outline-none focus:border-brand-purple">
        <option value="PL/SQL Migration">Migrate Legacy PL/SQL Events to BPA</option>
        <option value="Custom Workflow">New Custom BPMN Workflow Development</option>
        <option value="API Orchestration">External REST API / Webhook Integration</option>
        <option value="BPA Health Check">BPA Troubleshooting & Performance Audit</option>
      </select>
    </div>
  </div>

  <div>
    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Project Details / Current Bottlenecks</label>
    <textarea name="Description" rows="4" placeholder="Briefly describe the processes you want to automate, stuck asynchronous jobs, or upgrade timelines..." class="w-full px-4 py-2.5 rounded-lg bg-brand-dark border border-brand-border text-white focus:outline-none focus:border-brand-purple"></textarea>
  </div>

  <button type="submit" class="w-full py-3.5 px-6 font-semibold rounded-lg bg-gradient-to-r from-brand-blue to-brand-purple hover:opacity-95 transition-opacity text-white shadow-lg shadow-purple-900/30">
    Request BPA Architecture Consultation
  </button>
  <p class="text-xs text-center text-slate-400">Strict NDA observed. Routed straight to Automentra lead pipeline.</p>
</form>