---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Automentra`} description={post.data.description}>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <div class="mb-10 pb-8 border-b border-brand-border">
      <a href="/blog" class="text-xs text-purple-400 hover:text-purple-300 font-semibold mb-4 inline-block">← Back to Articles</a>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 leading-tight">
        {post.data.title}
      </h1>
      <div class="text-xs text-slate-400">
        Published on {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} • By {post.data.author}
      </div>
    </div>

    <div class="prose prose-invert max-w-none text-slate-300 leading-relaxed space-y-4">
      <Content />
    </div>

    <div class="mt-16 pt-8 border-t border-brand-border">
      <div class="p-6 rounded-xl bg-brand-surface border border-brand-border text-center">
        <h3 class="text-lg font-bold text-white mb-2">Need Help Modernizing Your IFS Workflows?</h3>
        <p class="text-xs text-slate-400 mb-4">Let Automentra design or refactor your BPMN 2.0 automations without technical debt.</p>
        <a href="/#contact" class="inline-block px-5 py-2.5 rounded-lg bg-gradient-to-r from-blue-600 to-purple-600 text-white text-xs font-semibold hover:opacity-95">
          Schedule Architecture Consultation
        </a>
      </div>
    </div>
  </article>
</Layout>