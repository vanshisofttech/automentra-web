---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Technical Insights & BPA Articles | Automentra">
  <div class="max-w-5xl mx-auto px-6 py-20">
    <div class="mb-12">
      <a href="/" class="text-xs text-purple-400 hover:text-purple-300 font-semibold mb-4 inline-block">← Back to Home</a>
      <h1 class="text-4xl font-extrabold text-white mb-4">Technical Insights & IFS Cloud Architecture</h1>
      <p class="text-slate-400 text-lg">In-depth guides on IFS Cloud BPA, BPMN 2.0 orchestration, and PL/SQL migrations.</p>
    </div>

    <div class="space-y-6">
      {posts.map((post) => (
        <article class="p-6 rounded-xl bg-brand-surface border border-brand-border hover:border-brand-purple transition-all">
          <div class="text-xs text-purple-400 font-semibold mb-2">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })} • {post.data.author}
          </div>
          <h2 class="text-2xl font-bold text-white mb-2">
            <a href={`/blog/${post.slug}`} class="hover:text-purple-300 transition-colors">
              {post.data.title}
            </a>
          </h2>
          <p class="text-slate-300 text-sm mb-4 leading-relaxed">{post.data.description}</p>
          <a href={`/blog/${post.slug}`} class="text-xs font-semibold text-purple-400 hover:text-purple-300">
            Read Full Article →
          </a>
        </article>
      ))}
      {posts.length === 0 && (
        <p class="text-slate-400">No articles published yet.</p>
      )}
    </div>
  </div>
</Layout>